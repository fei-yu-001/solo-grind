<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ddyu.zhikao.mapper.TagMapper">

    <select id="selectTagList" resultType="com.ddyu.zhikao.vo.TagVO">
        SELECT
            t.id,
            t.name,
            t.color,
            <choose>
                <when test="questionIds != null and questionIds.size() > 0">
                    (SELECT COUNT(*) FROM question_tag qt
                     WHERE qt.tag_id = t.id AND qt.question_id IN
                     <foreach collection="questionIds" item="qid" open="(" separator="," close=")">
                         #{qid}
                     </foreach>
                     ) AS questionCount
                </when>
                <otherwise>
                    (SELECT COUNT(*) FROM question_tag qt WHERE qt.tag_id = t.id) AS questionCount
                </otherwise>
            </choose>
        FROM tag t
        ORDER BY t.id
    </select>

</mapper>
